# PostgreSQL / Drizzle (server only; preserve the existing database)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# One-time administrator provisioning (server only; remove password afterward)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Required public Firebase Web app identifiers for real phone OTP.
# Copy from Firebase Console > Project settings > General > Your apps > Web app > Config.
# Also enable Phone Auth, allow India in SMS region policy and authorize the HTTPS app domain.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional web push only — NOT needed for phone OTP.
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Firebase Admin token verification: configure ONE of these on the server only.
# Never expose a service account through a NEXT_PUBLIC_* variable or commit the JSON.
FIREBASE_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=/secure/path/to/mounted-service-account.json
