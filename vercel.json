{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "nextjs"
    },
    "study-peace-new": {
      "root": "study-peace-new",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/study/:path*",
      "destination": {
        "service": "study-peace-new"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}